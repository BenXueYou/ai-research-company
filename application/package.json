{
  "name": "acquisition-identity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs watch --tsconfig tsconfig.server.json server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "build": "vue-tsc --noEmit && nest build --path tsconfig.server.json && vite build",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "db:migrate": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.server.json server/cli.ts migrate",
    "bootstrap": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.server.json server/cli.ts bootstrap",
    "upgrade": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.server.json server/upgrade-cli.ts",
    "test": "tsx --test tests/policy.test.ts",
    "test:members": "tsc -p tsconfig.server.json && node --env-file-if-exists=.env.test --test dist/tests/members.test.js",
    "test:integration": "tsc -p tsconfig.server.json && node --env-file-if-exists=.env.test --test --test-concurrency=1 dist/tests/identity.test.js dist/tests/organizations.test.js dist/tests/members.test.js dist/tests/smtp-channel.test.js dist/tests/umail.test.js dist/tests/company-search.test.js",
    "test:e2e": "npm run build && node --env-file-if-exists=.env.test node_modules/@playwright/test/cli.js test",
    "test:e2e:t19": "tsc -p tsconfig.server.json && vite build && node --env-file-if-exists=.env.test node_modules/@playwright/test/cli.js test --config config/playwright/playwright.t19.config.ts",
    "test:t20": "tsc -p tsconfig.server.json && node --env-file-if-exists=.env.test --test dist/tests/umail.test.js",
    "test:e2e:t20": "tsc -p tsconfig.server.json && vite build && node --env-file-if-exists=.env.test node_modules/@playwright/test/cli.js test --config config/playwright/playwright.t20.config.ts",
    "deploy": "node scripts/deploy.mjs",
    "test:deployment": "node --env-file-if-exists=.env.test tests/deployment.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "axios": "^1.21.0",
    "element-plus": "2.14.7",
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "pinia": "3.0.4",
    "redis": "^5.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "vue": "^3.5.0",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vue-tsc": "^3.1.0"
  },
  "packageManager": "pnpm@9.0.6+sha512.f6d863130973207cb7a336d6b439a242a26ac8068077df530d6a86069419853dc1ffe64029ec594a9c505a3a410d19643c870aba6776330f5cfddcf10a9c1617"
}
