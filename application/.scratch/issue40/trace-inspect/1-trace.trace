[[20,197]],[[20,198]],["SECTION",{"data-v-4cbba7aa":"","class":"role-help","aria-label":"帮助中心","request":"function(){const s=n1,a=r?new Proxy(e,{get(...l){return Lo=s,Reflect.get(...l)},set(...l){return Lo=s,Reflect.set(...l)}}):e;Lo=s;const i=n[o].apply(a,arguments);return Lo=void 0,i}"},["HEADER",{"data-v-4cbba7aa":""},["P",{"data-v-4cbba7aa":""},"平台运营操作指南"]],"",["SECTION",{"data-v-4cbba7aa":"","class":"help-section"},["H2",{"data-v-4cbba7aa":""},"直属开户与账号交付"],["P",{"data-v-4cbba7aa":""},"在下级管理中为直属下级开户，核对组织和管理员信息。开户后及时安全交付临时凭据；临时密码有效期 72 小时，首次登录必须改密。直属管理员密码重置也在授权范围内进行。"],["BUTTON",{"data-v-4cbba7aa":"","type":"button","class":"help-link"},"进入下级管理"]],["SECTION",{"data-v-4cbba7aa":"","class":"help-section"},["H2",{"data-v-4cbba7aa":""},"直属点数交易"],["P",{"data-v-4cbba7aa":""},"为直属下级建立点数订单，核对数量、价格和线下收款，再依订单状态处理预留、完整划拨或退款。库存不足、结果待确认等情况以订单现场提示和核对结果为准。"],["BUTTON",{"data-v-4cbba7aa":"","type":"button","class":"help-link"},"进入点数与账务"]],["SECTION",{"data-v-4cbba7aa":"","class":"help-section"},["H2",{"data-v-4cbba7aa":""},"采购与平台承担费用"],["P",{"data-v-4cbba7aa":""},"销售用途采购与补足上游额度分别留账；补足额度不生成新的内部可分配点数。已确认的损耗应关联核对，避免重复确认费用。销售毛利扣除平台承担费用后的结果不等于净利润。"],["BUTTON",{"data-v-4cbba7aa":"","type":"button","class":"help-link"},"进入采购与配置"]],["SECTION",{"data-v-4cbba7aa":"","class":"help-section"},["H2",{"data-v-4cbba7aa":""},"计价与上游核对"],["P",{"data-v-4cbba7aa":""},"接口点数单价、点数换算系数和最低加价率各有不同含义。内部可用余额与上游余额不能相加；上游状态更新需要主动操作，查询异常和迟到结果按现场依据核对。"],["BUTTON",{"data-v-4cbba7aa":"","type":"button","class":"help-link"},"进入上游与对账"]],"",["SECTION",{"data-v-4cbba7aa":"","class":"help-section"},["H2",{"data-v-4cbba7aa":""},"账号与常见问题"],["P",{"data-v-4cbba7aa":""},"在账号设置中输入当前密码和两次新密码。新密码须为 12–128 位可打印 ASCII 字符，不含空格，且不能与当前密码相同。修改成功后所有设备会话失效，需重新登录。"],["P",{"data-v-4cbba7aa":""},"临时密码到期后请联系有权管理账号的人员重新生成。首次使用临时密码时只能改密或退出；会话最长 8 小时，连续空闲 30 分钟后失效。"],["P",{"data-v-4cbba7aa":""},"费用、风险、错误及必需操作说明请以业务页面的实时提示为准；结果未确认时先核对状态，避免重复操作。"],["BUTTON",{"data-v-4cbba7aa":"","type":"button","class":"help-link"},"进入账号设置"]]],[[20,278]],[[20,279]],[[20,281]],[[20,282]],[[20,283]]],[[20,285]]],[[20,287]]]],[[22,12]],[[20,292]]]],"viewport":{"width":1280,"height":720},"timestamp":6444.861,"wallTime":1793186143219,"collectionTime":0.599999999627471,"resourceOverrides":[],"isMainFrame":true}}
