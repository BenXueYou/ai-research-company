+/* Public console owns the viewport; page components keep their lifecycle. */
+.app-shell.el-container { min-width: 0; }
+.app-shell:not(.workspace-mode) { display: block; }
+.console-header { padding: 0; }
+.console-column { min-width: 0; min-height: 0; }
+.workspace-mode.el-container { height: 100vh; height: 100dvh; overflow: hidden; background: #f2f4f9; }
+.workspace-mode .console-column { overflow: hidden; }
+.workspace-mode .console-header { flex: none; z-index: 5; background: #fff; }
+.workspace-mode .top-bar { min-height: 68px; padding: 10px 24px; flex-wrap: nowrap; align-items: center; gap: 16px; }
+.header-location { display: flex; align-items: center; gap: 16px; min-width: 0; flex: 1; }
+.workspace-mode .account-navigation { flex: none; margin-left: auto; }
+.workspace-mode .console-main { flex: 1; min-height: 0; min-width: 0; max-width: none; width: 100%; margin: 0; overflow: auto; overscroll-behavior: contain; padding: 24px; }
+.console-aside { flex: none; min-height: 0; overflow: hidden; background: #4657da; }
+.sidebar-panel, .workspace-sidebar { height: 100%; min-height: 0; display: flex; flex-direction: column; }
+.workspace-sidebar { color: #fff; padding: 0 12px; }
+.workspace-brand { flex: none; padding: 24px 10px; }
+.sidebar-scroll { flex: 1; min-height: 0; overflow: auto; overscroll-behavior: contain; display: flex; flex-direction: column; align-items: stretch; flex-wrap: nowrap; gap: 0; padding: 0 0 20px; }
+.sidebar-group { margin: 12px 12px 8px; color: #d9deff; }
+.sidebar-link { width: 100%; flex: none; min-height: 44px; border: 0; background: transparent; text-align: left; cursor: pointer; font: inherit; font-size: 13px; }
+.sidebar-link.active { background: #6574e2; border: 0; box-shadow: none; color: #fff; }
+.sidebar-link:not(.active):hover { background: #5667df; border: 0; }
+.sidebar-child { padding-left: 30px; }
+.sidebar-parent { justify-content: space-between; }
+.sidebar-help { margin-top: auto; }
+.sidebar-toggle, .sidebar-close { flex: none; display: inline-flex; align-items: center; gap: 7px; padding: 8px; border: 0; border-radius: 6px; font: inherit; font-size: 12px; color: #53617e; background: transparent; cursor: pointer; white-space: nowrap; }
+.sidebar-toggle:hover { background: #eef0f8; }
+.sidebar-close { color: #fff; margin: 8px; }
+.console-breadcrumb { display: flex; align-items: center; min-width: 0; flex: 1; line-height: 1.5; }
+.console-crumb { display: flex; min-width: 0; align-items: center; }
+.console-crumb:not(:last-child) .crumb-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.console-crumb:last-child { flex-shrink: 0; max-width: 100%; }
+.console-crumb:last-child .crumb-label { overflow-wrap: anywhere; }
