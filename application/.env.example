# Provide your own PostgreSQL credentials. No default production secrets.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/acquisition
APP_ORIGIN=http://127.0.0.1:3000
PORT=3000
NODE_ENV=development
# Integration/E2E tests refuse a database name not ending in _test.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/acquisition_test

# Independent 32-byte encryption/index key, 64 hex characters. Back up securely; do not rotate in place.
ORG_CONTACT_KEY=

# Independent 32-byte key for SMTP authorization credentials, 64 hex characters.
SMTP_CREDENTIAL_KEY=

# T18 archive attachments: an absolute private directory outside dist/web, backed up with the database.
COMPANY_ATTACHMENT_STORAGE_DIR=
# Scanner executable receives the private temporary file path as its final argument; exit 0 only for clean files.
COMPANY_ATTACHMENT_SCANNER=
# Optional JSON array of fixed scanner arguments, e.g. ["/absolute/path/to/scanner-script.mjs"].
COMPANY_ATTACHMENT_SCANNER_ARGS=[]

# T10 company-name search. API key is secret; never place it in browser configuration.
# Business daily quota is account-specific and must come from the supplier agreement.
REDIS_URL=redis://127.0.0.1:56379
TENGDAO_BASE_URL=
TENGDAO_API_KEY=
TENGDAO_BUSINESS_DAILY_LIMIT=
